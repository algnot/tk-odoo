<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_account_payment_form_preview_receipt" model="ir.ui.view">
    <field name="name">account.payment.form.preview.receipt</field>
    <field name="model">account.payment</field>
    <field name="inherit_id" ref="account.view_account_payment_form"/>
    <field name="arch" type="xml">
      <xpath expr="//header" position="inside">
        <button name="action_post_payment"
                type="object"
                string="Post"
                class="btn-primary"
                invisible="state != 'in_process'"/>
        <button name="action_preview_receipt"
                type="object"
                string="Preview Receipt"
                class="btn-secondary"
                icon="fa-file-pdf-o"/>
      </xpath>
    </field>
  </record>
</odoo>

