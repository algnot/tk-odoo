<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_account_payment_form_preview_receipt" model="ir.ui.view">
    <field name="name">account.payment.form.preview.receipt</field>
    <field name="model">account.payment</field>
    <field name="inherit_id" ref="account.view_account_payment_form"/>
    <field name="arch" type="xml">
      <xpath expr="//header" position="inside">
        <button name="action_post_payment"
                type="object"
                string="Post"
                class="btn-primary"
                invisible="state != 'in_process'"/>
        <button name="action_preview_receipt"
                type="object"
                string="Preview Receipt"
                class="btn-secondary"
                icon="fa-file-pdf-o"/>
      </xpath>

      <xpath expr="//div[@name='amount_div']" position="after">
        <div class="o_row" name="withholding_div">
          <label for="is_withholding_registation" string="หักภาษี ณ ที่จ่าย"/>
          <field name="is_withholding_registation" nolabel="1"/>
          <label for="withholding_percent" string="%"
                 invisible="not is_withholding_registation"/>
          <field name="withholding_percent"
                 nolabel="1"
                 invisible="not is_withholding_registation"/>
        </div>
      </xpath>
    </field>
  </record>
</odoo>

