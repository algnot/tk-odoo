<odoo>
    <template id="report_survey_certificate">
        <t t-call="web.basic_layout">
            <style>
                @font-face {
                  font-family: 'NotoSansThai';
                  src: url('/tk_sale_order/static/fonts/NotoSansThaiUI-Regular.ttf') format('truetype');
                }

                @font-face {
                  font-family: 'NotoSansThai';
                  src: url('/tk_sale_order/static/fonts/NotoSansThaiUI-Bold.ttf') format('truetype');
                  font-weight: bold;
                }

                html, body {
                    height: 100%;
                }

                .page {
                    height: 100%;
                }

                .certificate {
                    height: 100%;
                    box-sizing: border-box;
                    border: 6px solid #e6c87a;
                    padding: 40px;
                    text-align: center;
                    font-family: 'NotoSansThai' !important;
                }

                .cert-header h1 {
                    font-size: 42px;
                    margin-bottom: 5px;
                    color: #3a3a3a;
                }

                .cert-subtitle {
                    font-size: 16px;
                    color: #777;
                }

                .cert-name {
                    margin: 40px 0 30px;
                    font-size: 32px;
                    font-weight: bold;
                    color: #2c2c2c;
                    border-bottom: 2px solid #e6c87a;
                    display: inline-block;
                    padding-bottom: 8px;
                }

                .cert-body p {
                    font-size: 16px;
                    margin-bottom: 10px;
                    color: #555;
                }

                .cert-body h2 {
                    font-size: 22px;
                    color: #1f4f7a;
                    margin-top: 0;
                }

                .cert-footer {
                    margin-top: 60px;
                    display: flex;
                    justify-content: space-between;
                }

                .cert-footer .left,
                .cert-footer .right {
                    width: 40%;
                    text-align: center;
                    font-size: 14px;
                    color: #444;
                }

                .signature-line {
                    margin-top: 20px;
                    border-top: 1px solid #444;
                }
            </style>

            <t t-foreach="docs" t-as="doc">
                <div class="page certificate">

                    <!-- Title -->
                    <div class="cert-header">
                        <h1>Certificate of Completion</h1>
                        <p class="cert-subtitle">
                            This certificate is proudly presented to
                        </p>
                    </div>

                    <div class="cert-name">
                        <span t-esc="doc.nickname or '—'"/>
                    </div>

                    <div class="cert-body">
                        <p>
                            for successfully completing the survey
                        </p>
                        <h2 t-esc="doc.survey_id.title"/>
                    </div>

                    <div class="cert-footer">
                        <div class="left">
                            <p>Date</p>
                            <strong t-field="doc.write_date" t-options="{'widget': 'datetime'}"/>
                        </div>

                        <div class="right">
                            <p>Authorized Signature</p>
                            <div class="signature-line"/>
                        </div>
                    </div>
                </div>
            </t>
        </t>
    </template>
</odoo>
